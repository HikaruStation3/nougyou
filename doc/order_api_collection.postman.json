    {
      "name": "03 分支：取消订单与库存回滚",
      "item": [
        {
          "name": "API-052 再下一单（用于取消）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{buyerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"buyNow\",\n  \"productId\": 8,\n  \"quantity\": 3,\n  \"receiverName\": \"沈明\",\n  \"receiverPhone\": \"13800138000\",\n  \"receiverAddress\": \"莆田市仙游县钟山镇湖亭村 3 号\",\n  \"payType\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"业务码 00000\", () => pm.expect(j.code).to.eql(\"00000\"));",
                  "pm.collectionVariables.set(\"cancelOrderId\", j.data[0].id);",
                  "pm.test(\"新单待付款\", () => pm.expect(j.data[0].orderStatus).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-056 取消订单",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
