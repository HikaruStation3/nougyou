    {
      "name": "02 主链路 API-052 → 060",
      "item": [
        {
          "name": "API-052 提交订单（立即购买）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{buyerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"buyNow\",\n  \"productId\": 1,\n  \"quantity\": 2,\n  \"receiverName\": \"沈明\",\n  \"receiverPhone\": \"13800138000\",\n  \"receiverAddress\": \"莆田市仙游县钟山镇湖亭村 3 号\",\n  \"remark\": \"Postman 自动测试\",\n  \"payType\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"业务码 00000\", () => pm.expect(j.code).to.eql(\"00000\"));",
                  "const d = j.data;",
                  "pm.test(\"返回订单数组\", () => pm.expect(d).to.be.an(\"array\"));",
                  "pm.test(\"单商家只生成 1 单\", () => pm.expect(d.length).to.eql(1));",
                  "pm.collectionVariables.set(\"orderId\", d[0].id);",
                  "pm.collectionVariables.set(\"orderNo\", d[0].orderNo);",
                  "pm.test(\"初始状态待付款\", () => { pm.expect(d[0].orderStatus).to.eql(0); pm.expect(d[0].payStatus).to.eql(0); });",
                  "pm.test(\"金额=28×2\", () => pm.expect(Number(d[0].totalAmount)).to.eql(56));",
                  "pm.test(\"列表手机号脱敏\", () => pm.expect(d[0].receiverPhone).to.eql(\"138****8000\"));",
                  "pm.test(\"自营商品无委托ID\", () => pm.expect(d[0].items[0].entrustId).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-053 我的订单列表",
          "request": {
