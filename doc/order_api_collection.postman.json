                "orders"
              ],
              "query": [
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "orderStatus",
                  "value": "0"
                },
                {
                  "key": "keyword",
                  "value": "{{orderNo}}"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{buyerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"业务码 00000\", () => pm.expect(j.code).to.eql(\"00000\"));",
                  "const d = j.data;",
                  "pm.test(\"命中 1 条\", () => pm.expect(d.total).to.eql(1));",
                  "pm.test(\"单号一致\", () => pm.expect(d.list[0].orderNo).to.eql(pm.collectionVariables.get(\"orderNo\")));",
                  "pm.test(\"列表脱敏\", () => pm.expect(d.list[0].receiverPhone).to.eql(\"138****8000\"));"
                ]
              }
            }
          ]
        },
